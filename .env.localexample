# RDS (PostgreSQL) 접속 정보 — .env.local 템플릿
RDS_HOST=your-db-instance.xxxxxxxxxx.ap-northeast-2.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=evalats
RDS_USER=your_db_username
RDS_PASSWORD=your_db_password

DATABASE_URL=postgresql://your_db_username:your_db_password@your-db-instance.xxxxxxxxxx.ap-northeast-2.rds.amazonaws.com:5432/evalats
